

ALI_API_KEY=

# 邮件通知配置
# 设置 EMAIL_ENABLED=true 启用邮件通知
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
EMAIL_FROM=icd-autocoder@example.com
EMAIL_TO_ADMIN=admin@example.com

# 知识图谱配置 - 可选
# 默认使用 JSON 文件存储，无需配置
# 如果使用 Neo4j，格式：GRAPH_DB_URL=bolt://user:password@host:port
# 如果使用 NebulaGraph，格式：GRAPH_DB_URL=nebula://user:password@host:port/space
# 如果使用 AGE（PostgreSQL），格式：GRAPH_DB_URL=postgresql://user:password@host:port/database
# GRAPH_DB_URL=

# 数据库配置 - 可选
# 默认使用 JSON 文件存储，无需配置
# 如果使用 MySQL，格式：DATABASE_URL=mysql://user:password@host:port/database
# 如果使用 MongoDB，格式：DATABASE_URL=mongodb://user:password@host:port/database
# DATABASE_URL=

